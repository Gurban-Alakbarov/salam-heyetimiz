<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+): solid brand-green background + the badge/bubble
     foreground (kept inside the centre safe zone so no launcher mask ever clips it).
     API 23–25 fall back to the legacy mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
