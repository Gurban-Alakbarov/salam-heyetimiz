APP_NAME="Salam Həyətimiz"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Locale — az is the default & source of truth (PROJECT_CONSTITUTION R-LOC-01)
APP_LOCALE=az
APP_FALLBACK_LOCALE=az
APP_FAKER_LOCALE=az_AZ

# Human-time scheduler timezone (Tech Spec §6.6)
APP_SCHEDULE_TIMEZONE=Asia/Baku

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- Database: MariaDB 11, utf8mb4_unicode_ci (DB Arch §0) ----
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salam
DB_USERNAME=root
DB_PASSWORD=
# Read replica (R-ARCH-11). Leave equal to primary in local/dev.
DB_READ_HOST=127.0.0.1

# ---- Redis (HA / logical-DB split — R-ARCH-10) ----
# No ext-redis in local XAMPP → use predis client.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=1
REDIS_DB_LOCKS=2
REDIS_DB_BROADCASTING=3
REDIS_DB_IDEMPOTENCY=4

# Driver concerns map to logical Redis DBs
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ---- Reverb (WebSocket; 2 nodes in prod — R-ARCH-12) ----
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# ---- JWT signing keys (RS256, kid — R-SEC-08) ----
JWT_MOBILE_KID=mobile-2026-q3
JWT_ADMIN_KID=admin-2026-q3
JWT_MOBILE_PRIVATE_KEY_PATH=storage/keys/jwt-mobile.pem
JWT_ADMIN_PRIVATE_KEY_PATH=storage/keys/jwt-admin.pem
JWT_ACCESS_TTL_MINUTES=15
JWT_ADMIN_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=60

# ---- Integrations (filled in Phase 0 / later increments) ----
KAPITAL_BASE_URL=
KAPITAL_MERCHANT_ID=
KAPITAL_HMAC_SECRET=
KAPITAL_IP_ALLOWLIST=

SMS_PROVIDER=fake
SMS_BASE_URL=
SMS_API_KEY=

VOICE_GATEWAY_1_URL=
VOICE_GATEWAY_2_URL=

FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
# FCM_DRIVER=fake forces FakePushClient (local/CI without credentials); empty = real FCM HTTP v1.
FCM_DRIVER=

MAIL_MAILER=log
