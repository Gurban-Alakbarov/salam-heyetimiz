<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ runtime notification permission (FCM push). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Declared for the home-screen door widget's future background network call (W3). Release builds
         otherwise inherit INTERNET only from merged plugin manifests; declaring it here is explicit. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- GEOFENCE-3 — FOREGROUND location for the geofence open gate only. The app requests
         When-In-Use and reads a single fresh fix at open time. ACCESS_BACKGROUND_LOCATION is
         DELIBERATELY NOT declared (no background/widget GPS — GEOFENCE-1 LOCKED). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <application
        android:label="salam_mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- GEOFENCE-4: transparent confirmation dialog shown before a home-screen widget open
             (D2/D5). exported=false — only our own widget PendingIntent (an explicit component)
             can launch it. It carries only the AppWidgetId, never a token or a caller-chosen
             deviceId; the barrier is resolved from that widget's own stored config. -->
        <activity
            android:name=".ConfirmOpenActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- FCM: default channel id for notification-type messages (matches the Dart channel). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_importance_channel" />

        <!-- Home-screen "Qapını aç" widget (W1 static shell). exported=false: the OS AppWidget framework
             delivers APPWIDGET_UPDATE; no external app broadcasts here. The tap only opens the app for now
             (placeholder) — the real door-open callback is wired in W3. -->
        <receiver
            android:name=".DoorWidgetProvider"
            android:label="Qapını aç"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/door_widget_info" />
        </receiver>

        <!-- W3: receives the widget's background-open broadcast and hands off to home_widget's
             WorkManager background isolate, where doorWidgetOpenCallback reads the session token and
             calls the open endpoint. exported=false — only our own widget PendingIntent (an explicit
             component intent) targets it; no external app can reach it. -->
        <receiver
            android:name="es.antonborri.home_widget.HomeWidgetBackgroundReceiver"
            android:exported="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- map_launcher: navigation apps the "Directions" action can hand off to
             (Android 11+ package visibility). Plus the generic geo: intent. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <package android:name="com.google.android.apps.maps"/>
        <package android:name="com.waze"/>
        <package android:name="ru.yandex.yandexmaps"/>
        <package android:name="ru.yandex.yandexnavi"/>
        <package android:name="com.mapswithme.maps.pro"/>
        <!-- AzNav (Azerbaijan) — detected + launched natively (replaces Yandex on Android). -->
        <package android:name="net.sinam.aznav"/>
    </queries>
</manifest>
