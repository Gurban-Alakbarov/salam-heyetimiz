<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runner entitlements (wired via CODE_SIGN_ENTITLEMENTS). Push (APNs, production) for FCM, and universal
  links for https://sezam.salam.az/invite/* (served by /.well-known/apple-app-site-association with the
  Apple Team ID — APP_LINKS_IOS_APP_ID).
-->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:sezam.salam.az</string>
	</array>
</dict>
</plist>
