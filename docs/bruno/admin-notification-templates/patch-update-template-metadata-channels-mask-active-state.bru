meta {
  name: Update template metadata (channels mask, active state)
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/admin/v1/notification-templates/:key
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminJwt}}
}

body:json {
{
    "default_channels_mask": 0,
    "is_active": false
}
}
