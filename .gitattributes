# ─────────────────────────────────────────────────────────────────────────────
# Salam Həyətimiz — canonical monorepo .gitattributes.
# Purpose: normalize line endings so Windows (CRLF) vs Linux (LF) never produces
# thousands of false-positive "modified" diffs. Text is stored LF in the repo and
# checked out with the platform's native EOL; binaries are never EOL-processed.
# ─────────────────────────────────────────────────────────────────────────────

# Default: auto-detect text, store LF in the repo.
* text=auto

# ── Source / text (stored as LF) ─────────────────────────────────────────────
*.php        text
*.dart       text
*.kt         text
*.kts        text
*.java       text
*.swift      text
*.js         text
*.mjs        text
*.cjs        text
*.ts         text
*.tsx        text
*.jsx        text
*.json       text
*.jsonc      text
*.yaml       text
*.yml        text
*.xml        text
*.html       text
*.htm        text
*.css        text
*.scss       text
*.md         text
*.blade.php  text
*.gradle     text
*.properties text
*.bru        text
*.svg        text
*.txt        text
*.env.example text
.gitignore   text
.gitattributes text

# ── Shell scripts — MUST stay LF (broken if CRLF on the server) ──────────────
*.sh         text eol=lf
*.bash       text eol=lf

# ── Windows scripts — MUST stay CRLF ─────────────────────────────────────────
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# ── Binary (never EOL-processed, never diffed as text) ───────────────────────
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.bmp        binary
*.pdf        binary
*.ttf        binary
*.otf        binary
*.woff       binary
*.woff2      binary
*.eot        binary
*.mp4        binary
*.mov        binary
*.mp3        binary
*.wav        binary
*.zip        binary
*.gz         binary
*.tar        binary
*.jar        binary
*.apk        binary
*.aab        binary
*.keystore   binary
*.jks        binary
*.p12        binary
*.pfx        binary
