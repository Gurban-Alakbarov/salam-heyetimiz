meta {
  name: All settings grouped by section (secrets masked)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/v1/settings
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminJwt}}
}

docs {
  Requires `system.settings.manage`. Secret values are returned as `''` with a `secrets_set` map.
}
