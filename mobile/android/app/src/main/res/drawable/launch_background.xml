<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen (shown while the Flutter engine boots): brand-green background
     with the centred white-bubble logo, so there is no white flash before the Flutter
     SplashScreen (same bg colour + logo) draws. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
